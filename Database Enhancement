from __future__ import annotations

from dataclasses import dataclass
from enum import Enum
from typing import Dict, List, Optional, Tuple

import csv
import os
import tempfile

"""
This version extends the earlier in-memory application to demonstrate core database concepts
using a lightweight persistence layer (CSV file) while keeping the design modular and testable.
  - Persistent storage across sessions via CSV.
  - Basic "schema" enforcement and type conversion when reading CSV.
  - Integrity constraints (unique client_id).
  - Safe-write strategy (write to temp file, then atomic replace) to reduce corruption risk.
"""

# Domain Models

class Role(Enum):
    ADMIN = "admin"
    USER = "user"


@dataclass
class Client:
    client_id: int
    name: str
    balance: float
    status: str = "ACTIVE"


# Utilities

class InputValidator:

# InputValidator centralizes input parsing/validation

    @staticmethod
    def read_int_in_range(prompt: str, min_val: int, max_val: int) -> int:
        while True:
            raw = input(prompt).strip()
            try:
                value = int(raw)
                if min_val <= value <= max_val:
                    return value
                print(f"Please enter a number between {min_val} and {max_val}.")
            except ValueError:
                print("Invalid input. Please enter a valid integer.")

    @staticmethod
    def read_int(prompt: str) -> int:
        while True:
            raw = input(prompt).strip()
            try:
                return int(raw)
            except ValueError:
                print("Invalid input. Please enter a valid integer.")

    @staticmethod
    def read_nonempty(prompt: str) -> str:
        while True:
            value = input(prompt).strip()
            if value:
                return value
            print("Input cannot be empty.")

    @staticmethod
    def read_float(prompt: str) -> float:
        while True:
            raw = input(prompt).strip()
            try:
                return float(raw)
            except ValueError:
                print("Invalid input. Please enter a valid number.")

    @staticmethod
    def read_status(prompt: str) -> str:
        while True:
            status = input(prompt).strip().upper()
            if status in ("ACTIVE", "INACTIVE"):
                return status
            print("Invalid status. Enter ACTIVE or INACTIVE.")


# Authentication Service

class AuthenticationService:
    
# AuthenticationService handles the application's authentication decision

    def authenticate(self, username: str) -> Optional[Role]:
        if not username:
            return None
        return Role.ADMIN if username.lower() == "admin" else Role.USER


# Database Layer

class CSVClientRepository:

# CSV-backed repository that functions as a lightweight database.


    FIELDNAMES = ["client_id", "name", "balance", "status"]

    def __init__(self, filepath: str = "clients.csv") -> None:
        self.filepath = filepath
        self._ensure_file_exists()

    def _ensure_file_exists(self) -> None:
        if not os.path.exists(self.filepath):
            with open(self.filepath, "w", newline="", encoding="utf-8") as f:
                writer = csv.DictWriter(f, fieldnames=self.FIELDNAMES)
                writer.writeheader()

    def load_all(self) -> Dict[int, Client]:
        clients: Dict[int, Client] = {}
        with open(self.filepath, "r", newline="", encoding="utf-8") as f:
            reader = csv.DictReader(f)
            for row in reader:
                try:
                    cid = int(row["client_id"])
                    name = str(row["name"]).strip()
                    bal = float(row["balance"])
                    status = str(row.get("status", "ACTIVE")).strip().upper() or "ACTIVE"
                    if cid in clients:
                        continue
                    clients[cid] = Client(cid, name, bal, status)
                except (ValueError, KeyError):
                    continue
        return clients

    def save_all(self, clients: Dict[int, Client]) -> None:
        dir_name = os.path.dirname(os.path.abspath(self.filepath))
        fd, temp_path = tempfile.mkstemp(prefix="clients_", suffix=".csv", dir=dir_name)
        os.close(fd)

        try:
            with open(temp_path, "w", newline="", encoding="utf-8") as f:
                writer = csv.DictWriter(f, fieldnames=self.FIELDNAMES)
                writer.writeheader()

                for cid in sorted(clients.keys()):
                    c = clients[cid]
                    writer.writerow({
                        "client_id": c.client_id,
                        "name": c.name,
                        "balance": f"{c.balance:.2f}",
                        "status": c.status.upper()
                    })

            os.replace(temp_path, self.filepath)
        finally:
            if os.path.exists(temp_path):
                try:
                    os.remove(temp_path)
                except OSError:
                    pass


# Client Service

class ClientService:

# ClientService manages client records

    def __init__(self, repo: CSVClientRepository) -> None:
        self._repo = repo
        self._clients: Dict[int, Client] = self._repo.load_all()

        # Seed if file is empty (helps on first run)
        if not self._clients:
            self.add_client(Client(1001, "John Doe", 1500.00, "ACTIVE"))
            self.add_client(Client(1002, "Ava Martinez", 250.50, "ACTIVE"))
            self.add_client(Client(1003, "Noah Kim", 8000.00, "INACTIVE"))
            self.add_client(Client(1004, "Sophia Patel", 120.00, "ACTIVE"))

    def _persist(self) -> None:
        self._repo.save_all(self._clients)

    # CREATE

    def add_client(self, client: Client) -> bool:
        if client.client_id in self._clients:
            return False
        self._clients[client.client_id] = client
        self._persist()
        return True

    # READ

    def get_client(self, client_id: int) -> Optional[Client]:
        return self._clients.get(client_id)

    def list_clients_sorted_by_name(self) -> List[Client]:
        return sorted(self._clients.values(), key=lambda c: c.name.lower())

    def list_clients_sorted_by_balance(self, descending: bool = True) -> List[Client]:
        return sorted(self._clients.values(), key=lambda c: c.balance, reverse=descending)

    def filter_by_status(self, status: str) -> List[Client]:
        status_upper = status.upper()
        return [c for c in self._clients.values() if c.status.upper() == status_upper]

    def search_name_contains(self, query: str) -> List[Client]:
        q = query.lower()
        return [c for c in self._clients.values() if q in c.name.lower()]

    def summary_stats(self) -> Tuple[int, float, float]:
        clients = list(self._clients.values())
        count = len(clients)
        total = sum(c.balance for c in clients)
        avg = (total / count) if count else 0.0
        return count, total, avg

    # UPDATE

    def update_client_name(self, client_id: int, new_name: str) -> bool:
        client = self.get_client(client_id)
        if not client:
            return False
        client.name = new_name
        self._persist()
        return True

    def update_client_balance(self, client_id: int, new_balance: float) -> bool:
        client = self.get_client(client_id)
        if not client:
            return False
        client.balance = new_balance
        self._persist()
        return True

    def update_client_status(self, client_id: int, new_status: str) -> bool:
        client = self.get_client(client_id)
        if not client:
            return False
        client.status = new_status.upper()
        self._persist()
        return True

    # DELETE

    def delete_client(self, client_id: int) -> bool:
        if client_id not in self._clients:
            return False
        del self._clients[client_id]
        self._persist()
        return True


# UI Controller

class MenuController:

# MenuController drives the user experience

    def __init__(self, role: Role, client_service: ClientService) -> None:
        self.role = role
        self.client_service = client_service

    def display_menu(self) -> None:
        print("\nMenu Options:")
        print("1. View Client by ID (READ)")
        print("2. List Clients (sorted by name) (READ)")
        print("3. Search Clients by Name (READ)")
        print("4. Show Summary Statistics (READ)")
        print("5. Filter Clients by Status (READ)")

        if self.role == Role.ADMIN:
            print("6. Add Client (CREATE)")
            print("7. Update Client Name (UPDATE)")
            print("8. Update Client Balance (UPDATE)")
            print("9. Update Client Status (UPDATE)")
            print("10. Delete Client (DELETE)")
            print("11. List Clients (sorted by balance) (READ)")

        print("0. Exit")

    def run(self) -> None:
        while True:
            self.display_menu()

            max_choice = 11 if self.role == Role.ADMIN else 5
            choice = InputValidator.read_int_in_range("Select an option: ", 0, max_choice)

            if choice == 0:
                print("Exiting application.")
                return

            if choice == 1:
                self.view_client()
            elif choice == 2:
                self.list_clients_by_name()
            elif choice == 3:
                self.search_clients()
            elif choice == 4:
                self.show_stats()
            elif choice == 5:
                self.filter_status()
            elif self.role == Role.ADMIN and choice == 6:
                self.add_client()
            elif self.role == Role.ADMIN and choice == 7:
                self.update_client_name()
            elif self.role == Role.ADMIN and choice == 8:
                self.update_client_balance()
            elif self.role == Role.ADMIN and choice == 9:
                self.update_client_status()
            elif self.role == Role.ADMIN and choice == 10:
                self.delete_client()
            elif self.role == Role.ADMIN and choice == 11:
                self.list_clients_by_balance()

    # READ

    def view_client(self) -> None:
        client_id = InputValidator.read_int("Enter client ID: ")
        client = self.client_service.get_client(client_id)
        if not client:
            print("Client not found.")
            return
        self.print_client(client)

    def list_clients_by_name(self) -> None:
        clients = self.client_service.list_clients_sorted_by_name()
        print("\nClients (sorted by name):")
        for c in clients:
            self.print_client(c)

    def list_clients_by_balance(self) -> None:
        clients = self.client_service.list_clients_sorted_by_balance(descending=True)
        print("\nClients (sorted by balance, high to low):")
        for c in clients:
            self.print_client(c)

    def search_clients(self) -> None:
        query = InputValidator.read_nonempty("Enter name search text: ")
        results = self.client_service.search_name_contains(query)
        print(f"\nResults for '{query}':")
        if not results:
            print("No matching clients.")
            return
        for c in results:
            self.print_client(c)

    def show_stats(self) -> None:
        count, total, avg = self.client_service.summary_stats()
        print("\nClient Summary Statistics:")
        print(f"Total clients: {count}")
        print(f"Total balance: ${total:.2f}")
        print(f"Average balance: ${avg:.2f}")

    def filter_status(self) -> None:
        status = InputValidator.read_status("Enter status (ACTIVE/INACTIVE): ")
        results = self.client_service.filter_by_status(status)
        print(f"\nClients with status '{status.upper()}':")
        if not results:
            print("No clients found for that status.")
            return
        for c in results:
            self.print_client(c)

    # CREATE

    def add_client(self) -> None:
        cid = InputValidator.read_int("Enter new client ID: ")
        name = InputValidator.read_nonempty("Enter client name: ")
        bal = InputValidator.read_float("Enter starting balance: ")
        status = InputValidator.read_status("Enter status (ACTIVE/INACTIVE): ")

        ok = self.client_service.add_client(Client(cid, name, bal, status))
        print("Client added." if ok else "Client ID already exists.")

    # UPDATE

    def update_client_name(self) -> None:
        cid = InputValidator.read_int("Enter client ID: ")
        new_name = InputValidator.read_nonempty("Enter new name: ")
        ok = self.client_service.update_client_name(cid, new_name)
        print("Name updated." if ok else "Client not found.")

    def update_client_balance(self) -> None:
        cid = InputValidator.read_int("Enter client ID: ")
        new_bal = InputValidator.read_float("Enter new balance: ")
        ok = self.client_service.update_client_balance(cid, new_bal)
        print("Balance updated." if ok else "Client not found.")

    def update_client_status(self) -> None:
        cid = InputValidator.read_int("Enter client ID: ")
        new_status = InputValidator.read_status("Enter new status (ACTIVE/INACTIVE): ")
        ok = self.client_service.update_client_status(cid, new_status)
        print("Status updated." if ok else "Client not found.")

    # DELETE

    def delete_client(self) -> None:
        cid = InputValidator.read_int("Enter client ID to delete: ")
        client = self.client_service.get_client(cid)
        if not client:
            print("Client not found.")
            return

        self.print_client(client)
        confirm = InputValidator.read_nonempty("Type DELETE to confirm: ").strip().upper()
        if confirm != "DELETE":
            print("Delete cancelled.")
            return

        ok = self.client_service.delete_client(cid)
        print("Client deleted." if ok else "Delete failed.")

    @staticmethod
    def print_client(client: Client) -> None:
        print(f"- ID: {client.client_id} | Name: {client.name} | "
              f"Balance: ${client.balance:.2f} | Status: {client.status}")


# Application Entry

class ClientManagementApplication:

# ClientManagementApplication wires the system together and starts execution

    def __init__(self) -> None:
        self.auth_service = AuthenticationService()
        self.repo = CSVClientRepository("clients.csv")
        self.client_service = ClientService(self.repo)

    def run(self) -> None:
        print("Client Management System")
        username = InputValidator.read_nonempty("Enter username: ")

        role = self.auth_service.authenticate(username)
        if not role:
            print("Authentication failed.")
            return

        print(f"Logged in as {role.value}.")
        MenuController(role, self.client_service).run()


if __name__ == "__main__":
    ClientManagementApplication().run()
